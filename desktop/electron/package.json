{
  "name": "@dowflow/electron-shell",
  "version": "0.1.0",
  "private": true,
  "description": "DowFlow desktop media downloader and Music application",
  "productName": "DowFlow",
  "main": "main.cjs",
  "scripts": {
    "dev": "pnpm build:worker && electron .",
    "build:worker": "esbuild youtube/potoken-worker.js --bundle --platform=browser --format=cjs --external:electron --outfile=build/potoken-preload.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check music-launcher.cjs && node --test music-launcher.test.cjs && node --check youtube/potoken-service.cjs && pnpm build:worker",
    "package:win": "powershell -ExecutionPolicy Bypass -File ./build-win.ps1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "DowFlow.DowFlow",
    "productName": "DowFlow",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "music-launcher.cjs",
      "youtube/**/*",
      "build/potoken-preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../build/out/DowFlow",
        "to": "backend"
      },
      {
        "from": "../../static/dowflow.ico",
        "to": "static/dowflow.ico"
      },
      {
        "from": "../liner/release/win-unpacked",
        "to": "liner"
      }
    ],
    "win": {
      "icon": "../../static/dowflow.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "../../static/dowflow.ico",
      "uninstallerIcon": "../../static/dowflow.ico"
    }
  },
  "dependencies": {
    "bgutils-js": "4.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "youtubei.js": "18.3.0"
  }
}
