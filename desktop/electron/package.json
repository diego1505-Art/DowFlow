{
  "name": "@dowflow/electron-shell",
  "version": "0.1.0",
  "private": true,
  "description": "DowFlow desktop media downloader and Music application",
  "productName": "DowFlow",
  "main": "main.cjs",
  "scripts": {
    "dev": "pnpm build:music && pnpm build:worker && electron .",
    "build:music": "vite build --config renderer/vite.config.mts",
    "build:worker": "esbuild youtube/potoken-worker.js --bundle --platform=browser --format=cjs --external:electron --outfile=build/potoken-preload.cjs",
    "typecheck:music": "tsc --noEmit -p renderer/tsconfig.json",
    "check": "node --check main.cjs && node --check preload.cjs && node --check youtube/potoken-service.cjs && pnpm typecheck:music && pnpm build:music && pnpm build:worker"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.9.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "bgutils-js": "4.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "youtubei.js": "18.3.0"
  }
}
